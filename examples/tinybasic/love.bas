10 REM 143 = I LOVE YOU, FLASHED IN ALL 7 COLORS OF THE RGB LED
20 REM GPIO BITS 0-2 = RGB LED. P=1: LED ON AT 0, P=0: ON AT 1
30 G=&HF8015004: P=1: W=200
40 PRINT "143 means I LOVE YOU: 1, 4 and 3 letters"
50 FOR C=1 TO 7
60 PRINT "143 in ";: GOSUB 300: PRINT ": I LOVE YOU"
70 N=1: GOSUB 200
80 N=4: GOSUB 200
90 N=3: GOSUB 200
100 DELAY 3*W
110 NEXT C
120 POKE G,7*P: PRINT "Sent 7 times with love"
130 END
200 REM FLASH N TIMES IN COLOR C
210 FOR I=1 TO N
220 IF P=1 THEN POKE G,7-C
230 IF P=0 THEN POKE G,C
240 DELAY W: POKE G,7*P: DELAY W
250 NEXT I
260 DELAY 2*W: RETURN
300 IF C=1 THEN PRINT "red";
310 IF C=2 THEN PRINT "green";
320 IF C=3 THEN PRINT "yellow";
330 IF C=4 THEN PRINT "blue";
340 IF C=5 THEN PRINT "magenta";
350 IF C=6 THEN PRINT "cyan";
360 IF C=7 THEN PRINT "white";
370 RETURN
