10 REM LED ROTATE - TINY BASIC DEMO FOR THE SAPPHIRE SOC
20 G=&HF8015004: N=4: W=100
30 T=1: FOR I=2 TO N: T=T*2: NEXT I
40 PRINT "LED rotate on ";N;" LEDs"
50 PRINT "+ faster, - slower, space rotate/bounce, Ctrl-C stops"
60 L=1: D=1: M=0
70 POKE G,L: DELAY W
80 K=KEY
90 IF K=43 AND W>10 THEN W=W/2: PRINT "Delay ";W;" ms"
100 IF K=45 AND W<1000 THEN W=W*2: PRINT "Delay ";W;" ms"
110 IF K=32 THEN M=1-M: D=1
120 IF M=1 THEN 150
130 L=L*2: IF L>T THEN L=1
140 GOTO 70
150 IF L=T THEN D=0
160 IF L=1 THEN D=1
170 IF D=1 THEN L=L*2
180 IF D=0 THEN L=L/2
190 GOTO 70
