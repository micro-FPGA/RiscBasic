' String functions and string expressions

TARGET RV32IC
CLOCK  100_000_000
CODE   AT &H0000 SIZE 14336
RAM    AT &H3800 SIZE 2048 

CONST CR = 13
CONST LF = 10

'
' AMD IO Module
'
DEVICE GPIO AT &H8000_0000
  REG OUT  AT +16  WRITEONLY
  REG IN   AT +32  READONLY
END DEVICE

DEVICE UART0 AT &H8000_0000
  REG RXDATA AT +0 READONLY     ' RX FIFO
  REG DATA   AT +4 : 8
  REG STAT   AT +8 READONLY
  BIT RXREADY = STAT.0          ' RX FIFO has data
  BIT TXREADY = NOT STAT.3
END DEVICE

CONSOLE UART0

DIM name AS STRING * 20
DIM msg AS STRING * 32
DIM i AS WORD

FUNCTION Hex8(v AS WORD) AS STRING * 12
  RETURN "0x" + HEX$(v)
END FUNCTION

FUNCTION Greet(who AS STRING) AS STRING * 32
  RETURN "Hello, " + who + "!"
END FUNCTION

LINE INPUT "Name? ", name
PRINT CR, LF, Greet(name), CR, LF

FOR i = 1 TO 3
  msg = "item " + DEC$(i) + " at " + Hex8(i * 4096)
  PRINT msg, CR, LF
NEXT
END
