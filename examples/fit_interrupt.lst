;
; RiscBasic 0.35 listing: fit_interrupt.bas
; TARGET RV32IC   CODE 0x00000000 size 14336   RAM 0x00003800 size 2048   GP = 0x00004000
; compressed (C) instructions are marked c.; forward branches and calls stay 32-bit
;
; 0001  ' RiscBasic example: MicroBlaze V MCS, FIT1 interrupt through the IO Module INTC
; 0002  '
; 0003  ' MicroBlaze V MCS IP settings (Vivado, customize IP):
; 0004  '   FIT1: Use FIT = on, Number of Clocks Between Strobes = 100000, Generate Interrupt = on
; 0005  '   GPO1 and GPI1 for the LEDs and the button, UART on (as in include/CPU/MCS-V.bas)
; 0006  ' With an interrupt enabled, the MCS-V runs MicroBlaze V with low-latency interrupts: the
; 0007  ' core jumps to the vector the IO Module supplies. IntcInit points all vectors at the
; 0008  ' RiscBasic interrupt dispatcher (see MCS-V_INTC.bas).
; 0009  '
; 0010  ' The FIT strobes every FIT1_CLOCKS clocks: 1000 interrupts per second at 100 MHz. The
; 0011  ' interrupt handler counts them and blinks the green LED; the main program prints the
; 0012  ' uptime once per second and shows the button on the red LED.
; 0014  .include "include/CPU/MCS-V.bas"
; include/CPU/MCS-V.bas:0001  '
; include/CPU/MCS-V.bas:0002  ' AMD MicroBlaze MCS-V with 16K and compressed instruction support
; include/CPU/MCS-V.bas:0003  '
; include/CPU/MCS-V.bas:0005  TARGET RV32IC
; include/CPU/MCS-V.bas:0006  CLOCK  100_000_000
; include/CPU/MCS-V.bas:0007  CODE   AT &H0000 SIZE 14336
; include/CPU/MCS-V.bas:0008  RAM    AT &H3800 SIZE 2048
; include/CPU/MCS-V.bas:0010  '
; include/CPU/MCS-V.bas:0011  ' AMD IO Module
; include/CPU/MCS-V.bas:0012  '
; include/CPU/MCS-V.bas:0013  DEVICE GPIO0 AT &H8000_0000
; include/CPU/MCS-V.bas:0014  REG OUT  AT +16  WRITEONLY
; include/CPU/MCS-V.bas:0015  REG IN   AT +32  READONLY
; include/CPU/MCS-V.bas:0016  END DEVICE
; include/CPU/MCS-V.bas:0018  DEVICE UART0 AT &H8000_0000
; include/CPU/MCS-V.bas:0019  REG RXDATA AT +0 READONLY     ' RX FIFO
; include/CPU/MCS-V.bas:0020  REG DATA   AT +4 : 8
; include/CPU/MCS-V.bas:0021  REG STAT   AT +8 READONLY
; include/CPU/MCS-V.bas:0022  BIT RXREADY = STAT.0          ' RX FIFO has data
; include/CPU/MCS-V.bas:0023  BIT TXREADY = NOT STAT.3
; include/CPU/MCS-V.bas:0024  END DEVICE
; 0015  .include "include/CPU/MCS-V_INTC.bas"
; include/CPU/MCS-V_INTC.bas:0001  '
; include/CPU/MCS-V_INTC.bas:0002  ' AMD MicroBlaze V MCS: interrupt controller (INTC) of the IO Module
; include/CPU/MCS-V_INTC.bas:0003  '
; include/CPU/MCS-V_INTC.bas:0004  ' Register offsets and interrupt numbers from the IO Module driver
; include/CPU/MCS-V_INTC.bas:0005  ' (embeddedsw iomodule_v2_19, xiomodule_l.h, Vitis 2025.2).
; include/CPU/MCS-V_INTC.bas:0006  ' Include after include/CPU/MCS-V.bas.
; include/CPU/MCS-V_INTC.bas:0007  '
; include/CPU/MCS-V_INTC.bas:0009  CONST IOM_BASE = &H8000_0000
; include/CPU/MCS-V_INTC.bas:0011  DEVICE IOM AT &H8000_0000
; include/CPU/MCS-V_INTC.bas:0012  REG MODE    AT +&H0C WRITEONLY    ' IRQ_MODE: per interrupt 1 = fast (vectored), 0 = normal
; include/CPU/MCS-V_INTC.bas:0013  REG STATUS  AT +&H30 READONLY     ' IRQ_STATUS: latched interrupt requests
; include/CPU/MCS-V_INTC.bas:0014  REG PENDING AT +&H34 READONLY     ' IRQ_PENDING: STATUS AND ENABLE
; include/CPU/MCS-V_INTC.bas:0015  REG ENABLE  AT +&H38 WRITEONLY    ' IRQ_ENABLE: cannot be read back, RiscBasic keeps a shadow
; include/CPU/MCS-V_INTC.bas:0016  REG ACK     AT +&H3C              ' IRQ_ACK: write a mask of 1s to clear STATUS bits.
; include/CPU/MCS-V_INTC.bas:0017  ' Write whole masks only: ACK cannot be read, so a bit
; include/CPU/MCS-V_INTC.bas:0018  ' assignment (read-modify-write) would ack random bits.
; include/CPU/MCS-V_INTC.bas:0019  BIT FIT1_PENDING = PENDING.7
; include/CPU/MCS-V_INTC.bas:0020  BIT FIT1_ENABLE  = ENABLE.7
; include/CPU/MCS-V_INTC.bas:0021  BIT PIT1_PENDING = PENDING.3
; include/CPU/MCS-V_INTC.bas:0022  BIT PIT1_ENABLE  = ENABLE.3
; include/CPU/MCS-V_INTC.bas:0023  END DEVICE
; include/CPU/MCS-V_INTC.bas:0025  ' interrupt numbers (bit positions in STATUS, PENDING, ENABLE, ACK, MODE)
; include/CPU/MCS-V_INTC.bas:0026  CONST IRQ_UART_ERR = 0
; include/CPU/MCS-V_INTC.bas:0027  CONST IRQ_UART_TX  = 1
; include/CPU/MCS-V_INTC.bas:0028  CONST IRQ_UART_RX  = 2
; include/CPU/MCS-V_INTC.bas:0029  CONST IRQ_PIT1     = 3              ' PIT2..PIT4 = 4..6
; include/CPU/MCS-V_INTC.bas:0030  CONST IRQ_FIT1     = 7              ' FIT2..FIT4 = 8..10
; include/CPU/MCS-V_INTC.bas:0031  CONST IRQ_GPI1     = 11             ' GPI2..GPI4 = 12..14
; include/CPU/MCS-V_INTC.bas:0032  CONST IRQ_EXT0     = 16             ' INTC_Interrupt inputs from bit 16 up
; include/CPU/MCS-V_INTC.bas:0034  CONST FIT1_MASK = 1 SHL IRQ_FIT1
; include/CPU/MCS-V_INTC.bas:0036  '
; include/CPU/MCS-V_INTC.bas:0037  ' Put the INTC into a known state: all interrupts off and in normal mode, everything
; include/CPU/MCS-V_INTC.bas:0038  ' acknowledged, and the interrupt vectors pointing at the RiscBasic interrupt dispatcher.
; include/CPU/MCS-V_INTC.bas:0039  '
; include/CPU/MCS-V_INTC.bas:0040  ' Vectors (IRQ_VECTOR, one word per interrupt from offset &H80): the MCS-V builds the IO
; include/CPU/MCS-V_INTC.bas:0041  ' Module with fast interrupt support and runs MicroBlaze V with low-latency interrupts, where
; include/CPU/MCS-V_INTC.bas:0042  ' the IO Module supplies a handler address with each interrupt. Every vector gets the address
; include/CPU/MCS-V_INTC.bas:0043  ' of __trap, the dispatcher that runs the ON IRQ blocks; the startup code sets mtvec to it
; include/CPU/MCS-V_INTC.bas:0044  ' too, so the interrupt reaches __trap whichever of the two the core uses.
; include/CPU/MCS-V_INTC.bas:0045  ' On this core mret is a no-op; the RiscBasic dispatcher returns without it (spec section 7).
; include/CPU/MCS-V_INTC.bas:0046  '
; ---- startup ----
