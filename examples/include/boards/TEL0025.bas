'
' Trenz TEL0025 (Lattice Certus-NX) with the LiteX target trenz_tel0025
'
' RGB LED on the LEDS module of the SoC. A write to LEDS.OUT takes the LED over
' from the LiteX LED chaser.
'
ALIAS LED        = LEDS.OUT.0
ALIAS RED_LED    = LEDS.OUT.0
ALIAS GREEN_LED  = LEDS.OUT.1
ALIAS BLUE_LED   = LEDS.OUT.2
