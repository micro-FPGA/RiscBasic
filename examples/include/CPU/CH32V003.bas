' 
' CH32V003
'
' NOT READY, only basic settings are done
' 

TARGET RV32EC
CLOCK  48_000_000
CODE   AT &H0000 SIZE 16K
RAM    AT &H4000 SIZE 2K

'
' TDODO read the manual and fix!!!
'
DEVICE GPIOA AT &H4001_0800
  REG CFG  AT +0  
  REG OUT  AT +12 WRITEONLY
  REG IN   AT +8  READONLY
END DEVICE

DEVICE GPIOC AT &H4001_1000
  REG CFG  AT +0
  REG OUT  AT +12 WRITEONLY
  REG IN   AT +8  READONLY
END DEVICE

DEVICE GPIOD AT &H4001_1400
  REG CFG  AT +0
  REG OUT  AT +12 WRITEONLY
  REG IN   AT +8  READONLY
END DEVICE


DEVICE UART0 AT &H4001_3800
  REG RXDATA AT +4 : 8 ' RX FIFO
  REG DATA   AT +4 : 8
  REG STAT   AT +0 READONLY
  REG BRR    AT +8
  REG CTRL1  AT +12
  REG CTRL2  AT +16
  REG CTRL3  AT +20
  REG GPR    AT +24
  BIT RXREADY = STAT.5          ' RX FIFO has data
  BIT TXREADY = STAT.7
END DEVICE


